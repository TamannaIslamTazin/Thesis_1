// ============================================================================
// INSTITUTIONS
// ============================================================================

/// Healthcare institutions (issuers/verifiers)
/// A one-time token an L1 officer shows as a QR so an L2 institution's software
/// can pair with the issuer console and be onboarded.
///
/// WHY A TOKEN RATHER THAN THE OFFICER TYPING A URL INTO THE HOSPITAL MACHINE.
/// The officer is standing in the building; the software is on a counter PC
/// nobody wants to configure. Scanning is the whole onboarding interaction, and
/// it must be safe to show on a shared screen.
///
/// THE TOKEN MINTS NOTHING BY ITSELF. Redeeming it pairs the software to the
/// officer's console session; the officer then confirms what they verified on
/// site, and only that confirmation mints. If a bitmap alone minted, the
/// authorisation would come from the QR rather than from the officer's
/// judgement, and the site visit — the one thing that makes an institution
/// trustworthy — would be decorative.
///
/// SINGLE USE, ATOMICALLY CLAIMED. Spent by
/// `updateMany({ where: { id, status: 'PENDING' } })`; `count !== 1` is the loss,
/// the same shape as `consumeChallenge` and the console's single-use key release.
/// A read-then-write would let two scans both succeed.
model InstitutionEnrolment {
  id            String   @id @default(cuid())
  /// What the QR carries. Random and unguessable; never the row id.
  token         String   @unique
  /// The officer who created it, as an InstitutionMember.
  ///
  /// NOT a User. `InstitutionMember` is a ROSTER OF EMAILS with no relation to
  /// `User` — they join only on the shared `email` column, which is why
  /// `requireAuthorityMember` says email is the only column the two share. Two
  /// seeded officers (`officer@bnmc`, `officer@pcb`) have NO `User` row at all,
  /// so a foreign key to `User.id` could not even be satisfied for every officer.
  /// Measured 24 Sep 2026: the original FK to `User.id` failed with
  /// `Foreign key constraint violated: InstitutionEnrolment_officerMemberId_fkey`.
  officerMemberId String
  officer       InstitutionMember @relation("OfficerEnrolments", fields: [officerMemberId], references: [id])
  /// The L1 authority the officer acts for. The minted DID's trust anchors here.
  authorityId   String

  /// Set by the scanning software, so the officer can SEE they are confirming
  /// the right machine rather than an unknown one.
  claimedBy           String?
  claimedAt           DateTime?
  /// The scanning software's OWN Ed25519 public key, multibase-encoded.
  ///
  /// SO THE INSTITUTION HOLDS ITS OWN KEY. The minted document always carries
  /// one agent-held slot (#key-officer-1) because the SDK guard demands the
  /// ledger-signing key be one this agent can sign with. A second slot from THIS
  /// key is what makes the institution a 2-of-N that controls itself rather than
  /// a 1-of-1 whose only key lives in the backend — which would be custody under
  /// a different name (CLAUDE.md, custody principles).
  ///
  /// Optional only so an institution whose software cannot yet generate a key can
  /// still be onboarded; when absent the document is 1-of-1, agent-held, and the
  /// response says so rather than implying otherwise.
  claimantPublicKey   String?
  /// The institution, once created.
  institutionId       String?  @unique

  status        EnrolmentStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime        @default(now())

  @@index([officerMemberId])
  @@index([status])
}

enum EnrolmentStatus {
  PENDING
  /// Scanned by the institution's software, awaiting the officer's confirmation.
  CLAIMED
  /// The institution was created and its DID minted.
  COMPLETED
  EXPIRED
  /// Cancelled by the officer, or abandoned.
  REVOKED
}

model Institution {
  id              String           @id @default(cuid())
  did             String?          @unique
  
  // Basic info
  name            String
  type            InstitutionType
  description     String?
  
  // Contact
  email           String?
  phone           String?
  website         String?
  
  // Address
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  
  // Verification status
  isVerified      Boolean          @default(false)
  verifiedAt      DateTime?
  verificationDocs Json?
  
  // Branding
  logoUrl         String?
  primaryColor    String?
  
  // API access
  apiKey          String?          @unique
  apiKeyHash      String?
  webhookUrl      String?
  
  // Status
  isActive        Boolean          @default(true)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  members         InstitutionMember[]
  issuanceRequests IssuanceRequest[]

  @@index([did])
  @@index([type])
  @@index([apiKey])
}

enum InstitutionType {
  HOSPITAL
  CLINIC
  PHARMACY
  LABORATORY
  INSURANCE
  RESEARCH
  GOVERNMENT
  OTHER
  /// L1: the ministry, for health-card issuance (IDENTITY-AND-ISSUANCE-SPEC.md §1).
  MINISTRY
  /// L1: a professional council — BMDC, BNMC, PCB — for licence issuance.
  REGULATOR
}

/// Institution member (staff).
///
/// EMPLOYMENT ONLY — THIS MODEL DOES NOT ANSWER "MAY THEY". It records that a
/// person is on an institution's roster, which is a fact the institution owns
/// and can revoke by setting isActive.
///
/// It used to carry `role`, `canIssue`, `canVerify` and `canManageMembers`.
/// Those four columns gated nothing: no route and no middleware ever read them
/// (#253). They were removed in R4 rather than wired up, because the next
/// reader would reasonably have taken them for the authorization answer and
/// they are not — professional authority is a credential from an accrediting
/// authority, verified at presentation time by `requireProfessional`. See
/// `packages/shared/src/accreditation/`. Do not reintroduce a capability column
/// here; a permission this server can grant itself is the centralised trust the
/// system exists to remove.
/// Which of an L1 authority's own staff a member is. Gates ONLY the L1
/// issuer-dashboard endpoints added for identity/licence issuance
/// (IDENTITY-VERIFICATION-API.md §5) — it says nothing about clinical
/// authority, which remains a presented credential per the module header
/// above. `OFFICER` covers queue review, approval and rejection (open to
/// `ADMIN` too — see `requireAuthorityRole`'s header for why those routes are
/// not additionally role-gated); `ADMIN` is required for roster management
/// (`routes/authorityMembers.ts`, OFFICER-DOCUMENT-ACCESS.md §7): creating a
/// colleague, changing a role, or deactivating a member.
enum InstitutionMemberRole {
  OFFICER
  ADMIN
}

model InstitutionMember {
  id              String   @id @default(cuid())
  institutionId   String

  // Member info
  email           String
  name            String
  role            InstitutionMemberRole @default(OFFICER)

  // Status
  isActive        Boolean  @default(true)
  invitedAt       DateTime @default(now())
  acceptedAt      DateTime?

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  /// Enrolment tokens this member created as an L1 officer. A site visit is
  /// something a PERSON did, so the enrolment is attributed to their roster row.
  officerEnrolments InstitutionEnrolment[] @relation("OfficerEnrolments")

  @@unique([institutionId, email])
  @@index([institutionId])
  @@index([email])
}

