// SSI Healthcare - Prisma Schema
// Comprehensive database schema for Self-Sovereign Identity management

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// CORE IDENTITY
// ============================================================================

/// User account - represents a credential holder (patient) or institutional user
model User {
  id            String    @id @default(cuid())
  did           String?   @unique // DID created after wallet setup
  /// Optional as of the auth/keystore round (2026-09-05): the wallet's
  /// new-device flow (IDENTITY-AND-ISSUANCE-SPEC.md §4/§6) mints an account
  /// from a DID and a passphrase-wrapped recovery envelope, with no mailbox at
  /// all. Every row that predates this change already carries a non-null
  /// unique email, so relaxing NOT NULL is a no-op for them — see the migration
  /// header for the exact ALTER statement and why it touches no existing data.
  /// `@unique` still holds: Postgres permits any number of NULLs in a unique
  /// index, so it keeps deduplicating real addresses without constraining the
  /// email-less rows against each other.
  email         String?   @unique
  emailVerified DateTime?
  
  // Profile
  firstName     String?
  lastName      String?
  displayName   String?
  avatarUrl     String?
  phone         String?
  
  // Authentication
  passwordHash  String?   // For email/password auth
  totpSecret    String?   // For 2FA
  totpEnabled   Boolean   @default(false)
  
  // Wallet status
  walletSetup   Boolean   @default(false)
  walletType    WalletType?
  
  // Security settings
  biometricEnabled Boolean @default(false)
  autoLockMinutes  Int     @default(5)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  accounts          Account[]
  sessions          Session[]
  passkeys          Passkey[]
  credentials       Credential[]
  consentsGiven     Consent[]        @relation("HolderConsents")
  auditLogs         AuditLog[]       @relation("ActorLogs")
  targetLogs        AuditLog[]       @relation("TargetLogs")
  emergencyContacts EmergencyContact[] @relation("UserContacts")
  emergencyAccessTo EmergencyContact[] @relation("EmergencyContactUser")
  webhooks          Webhook[]
  notificationPrefs NotificationPreference?
  hospitalConnections HospitalConnection[]
  issuanceRequests    IssuanceRequest[]


  @@index([email])
  @@index([did])
}

enum WalletType {
  CLOUD       // Custodial cloud wallet (easier onboarding)
  DEVICE      // Device-bound keys
  HARDWARE    // Hardware security module
  HYBRID      // Cloud + device backup
}

// ============================================================================
// DID CHALLENGE-RESPONSE LOGIN
// ============================================================================

/// A server-issued, single-use login nonce for POST /api/auth/did-login.
///
/// THE NONCE IS OURS, never the caller's — same rule as
/// `services/professionalChallenge.ts` and `packages/locker/src/db.ts`:
/// generated here, stored here, spent here. `consumeChallenge` in
/// `services/didLoginAuth.ts` moves a row out of ISSUED with a single
/// conditional `updateMany`, and only the caller that observes `count === 1`
/// may proceed — the same compare-and-swap those two modules use, reimplemented
/// against Postgres because this backend does not share a datastore with
/// either of them (locker is deliberately dependency-minimal and self-hosted;
/// see its package.json).
model AuthChallenge {
  id         String          @id @default(cuid())
  nonce      String          @unique
  did        String
  /// This deployment's own DID, from `VERIFIER_DID` — the same "who are we"
  /// value `requireProfessional` already binds presentations to. Reused rather
  /// than introducing a second audience concept.
  audience   String
  state      ChallengeState  @default(ISSUED)
  issuedAt   DateTime        @default(now())
  expiresAt  DateTime

  @@index([did])
  @@index([state])
}

enum ChallengeState {
  /// Issued, not yet spent. The only state `consumeChallenge` may move out of.
  ISSUED
  SPENT
  EXPIRED
}

// ============================================================================
// KEYSTORE VAULT — the passphrase-wrapped recovery envelope
// ============================================================================

/// The opaque, passphrase-sealed recovery-key envelope for the new-device
/// login path (spec §6, §7a). Addressed ONLY by an HMAC of the phone handle —
/// deliberately carries NO userId, NO did and NO plaintext phone number, so
/// that a leak of this table alone cannot produce a list of enrolled numbers
/// linked to identities (AUTH-AND-KEYSTORE-API.md §4). The join a caller would
/// need — which handle belongs to which account — exists nowhere in this
/// database.
///
/// `envelope` is stored and returned verbatim. This server derives no key from
/// it and does not attempt to open it — see `services/keystoreVault.ts`.
model KeystoreEnvelope {
  id          String   @id @default(cuid())
  /// HMAC-SHA256(KEYSTORE_HANDLE_PEPPER, normalised handle), hex. The only key
  /// this row is ever looked up by.
  handleHmac  String   @unique
  /// HMAC-SHA256(KEYSTORE_OWNER_PEPPER, userId), hex. Authorises REPLACING an
  /// existing slot by the same account that created it, without this table
  /// holding — or being joinable to — a userId, a DID or a phone number.
  /// Different pepper from `handleHmac` so leaking one derivation's pepper
  /// does not help invert the other.
  ownerTag    String
  envelope    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// OAuth accounts (Google, Apple, Microsoft)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // "oauth" | "email" | "credentials"
  provider          String  // "google" | "apple" | "microsoft" | "email"
  providerAccountId String
  
  // OAuth tokens
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// User sessions
/// Session lifecycle state.
///
/// POST /api/auth/login creates a session row to hold the OTP challenge and
/// returns its token to a caller who has NOT yet proven control of the mailbox.
/// That row must never authenticate a request. `status` is the predicate that
/// enforces it, and it is filtered inside findSessionByToken so no call site
/// can forget to apply it.
enum SessionStatus {
  /// OTP issued, not yet verified. NOT a valid bearer token.
  PENDING_VERIFICATION
  /// Identity proven. Usable for authenticated requests.
  ACTIVE
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique

  // Refresh token for automatic token renewal
  refreshToken      String?  @unique
  refreshExpiresAt  DateTime?

  /// Defaults to ACTIVE so that existing rows and every non-OTP creation path
  /// (OAuth, passkey, refresh) keep working. The magic-link login path sets
  /// PENDING_VERIFICATION explicitly.
  status       SessionStatus @default(ACTIVE)

  // Session metadata
  userAgent    String?
  ipAddress    String?
  deviceName   String?

  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@index([status])
}

/// WebAuthn passkeys for passwordless auth
model Passkey {
  id               String   @id @default(cuid())
  userId           String
  
  // WebAuthn credential data
  credentialId     String   @unique
  publicKey        Bytes
  counter          BigInt   @default(0)
  transports       String[] // ["internal", "usb", "ble", "nfc"]
  
  // Metadata
  deviceName       String?
  lastUsedAt       DateTime?
  
  createdAt        DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([credentialId])
}

// ============================================================================
// DECENTRALIZED IDENTIFIERS
// ============================================================================

/// DID document storage
model DIDDocument {
  id              String    @id @default(cuid())
  did             String    @unique
  method          DIDMethod
  
  // DID Document content
  document        Json      // Full DID Document
  
  // Key references (extracted for quick lookup)
  verificationMethods Json? // Array of verification method IDs
  
  // Status
  status          DIDStatus @default(ACTIVE)
  deactivatedAt   DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([did])
  @@index([method])
}

enum DIDMethod {
  KEY     // did:key
  WEB     // did:web
  CHEQD   // did:cheqd
  ION     // did:ion
  PEER    // did:peer
}

enum DIDStatus {
  ACTIVE
  DEACTIVATED
  REVOKED
}

// ============================================================================
// VERIFIABLE CREDENTIALS
// ============================================================================

/// Verifiable Credential storage
model Credential {
  id              String           @id @default(cuid())
  holderUserId    String?
  holderDid       String
  issuerDid       String
  
  // Credential metadata
  type            String[]         // ["VerifiableCredential", "HealthCredential"]
  category        CredentialCategory
  name            String
  description     String?
  
  // Credential data.
  //
  // `credentialData` holds the W3C Verifiable Credential — the DATA MODEL only.
  // On its own it proves nothing; it carries no signature for VC 2.0.
  //
  // `credentialJwt` holds the ENVELOPING PROOF: the compact JWT that secures
  // the credential above. VC 2.0 separates the data model from the securing
  // mechanism, so these are two columns rather than one — the signature is not
  // a property of the credential and storing it inside `credentialData` would
  // misrepresent an enveloped proof as an embedded one.
  //
  // Null for legacy VC 1.1 rows, which carry the same string at
  // `credentialData.proof.jwt`, and for Data Integrity proofs, which have no
  // envelope. Read it via `credentialEnvelopeJwt()` in services/jwtVc.ts rather
  // than reaching for either location directly.
  // `credentialFormat` says WHICH securing mechanism `credentialJwt` holds:
  // `vc+jwt` (compact JWT) or `vc+sd-jwt` (compact SD-JWT, issuer JWT followed
  // by tilde-separated disclosures). The two are not interchangeable — an
  // SD-JWT splits into five `.`-segments, not three, so every naive JWT reader
  // mis-parses it, and presenting one requires choosing a disclosure frame.
  //
  // EXPLICIT RATHER THAN SNIFFED. The structures are distinguishable, but a
  // reader that sniffs mis-handles the first shape it did not anticipate and
  // fails in the holder's wallet rather than here. The issuer knows at
  // issuance; it is written down then.
  //
  // Null for pre-migration VC 1.1 rows, which have no envelope at all and keep
  // their signature at `credentialData -> 'proof' ->> 'jwt'`. Null therefore
  // means "legacy embedded proof", not "unknown".
  credentialData  Json             // The VC JSON
  credentialJwt   String?          // Compact JWT / SD-JWT envelope (VC 2.0 securing mechanism)
  credentialFormat String?         // 'vc+jwt' | 'vc+sd-jwt'; null = legacy VC 1.1
  credentialHash  String           @unique // SHA-256 hash for integrity
  
  // Schema reference
  schemaId        String?
  schemaVersion   String?
  
  // Status
  status          CredentialStatus @default(ACTIVE)
  issuedAt        DateTime
  expiresAt       DateTime?
  revokedAt       DateTime?
  revocationReason String?
  
  // Usage tracking
  lastUsedAt      DateTime?
  useCount        Int              @default(0)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Revocation — the credential's entry in its issuer's BitstringStatusList.
  // `statusListIndex` is the bit position reserved for THIS credential in the
  // on-ledger bitstring; it is allocated once at issuance and never reused,
  // because reuse would silently transfer one credential's revocation to
  // another. Both are null for credentials issued before status lists existed
  // and for externally-issued credentials whose status we do not control.
  statusListId    String?
  statusListIndex Int?

  // Relations
  holder          User?            @relation(fields: [holderUserId], references: [id])
  presentations   PresentationCredential[]
  schema          CredentialSchema? @relation(fields: [schemaId], references: [id])
  statusList      CredentialStatusList? @relation(fields: [statusListId], references: [id])

  @@unique([statusListId, statusListIndex])
  @@index([holderUserId])
  @@index([holderDid])
  @@index([issuerDid])
  @@index([category])
  @@index([status])
}

/// A W3C Bitstring Status List published as a cheqd DID-Linked Resource.
///
/// PARTITION: one list per (issuerDid, purpose). Not per credential type.
/// A status list is a herd-privacy device: a verifier that dereferences the
/// list learns only "someone asked about this issuer's revocation list", and
/// the denser the list the less that tells them. Partitioning per credential
/// type would shrink each list and leak the credential's type to whoever
/// serves it; a list of one would be a direct identifier for the credential
/// itself. The spec's 131,072-entry minimum exists for exactly this reason,
/// and one list per issuer is the coarsest partition that still lets an
/// issuer revoke only its own credentials.
///
/// THE LEDGER IS THE PUBLISHED COPY, NOT THE SOURCE OF TRUTH. The bitstring
/// is never stored here — it is regenerated from
/// `Credential.status = REVOKED` on every publish, so the on-ledger list
/// cannot drift away from the database. This row only holds what cannot be
/// derived: the resource's ledger coordinates and the index allocator.
model CredentialStatusList {
  id             String   @id @default(cuid())

  /// The cheqd DID whose collection holds the resource. Also the VC issuer.
  issuerDid      String
  /// `revocation` or `suspension` — the BitstringStatusList statusPurpose.
  purpose        String   @default("revocation")

  /// DLR coordinates. Name + type are the STABLE key: cheqd versions a
  /// resource by (collectionId, name, resourceType), and a
  /// `?resourceName=&resourceType=` DID URL dereferences to the newest
  /// version. That URL — not a pinned `/resources/<uuid>` one — is what
  /// `statusListCredential` points at, so re-publishing updates every
  /// credential already in the wild.
  resourceName   String
  resourceType   String   @default("BitstringStatusListRevocation")
  /// Most recently written resource UUID and its version label. Kept for
  /// audit and for resolving a specific historical version; not used for
  /// normal status lookups.
  latestResourceId String?
  version        Int      @default(0)

  /// Total bits in the list. 131072 is the spec minimum (16KB uncompressed).
  length         Int      @default(131072)
  /// Next free bit position. Monotonic: indices are never recycled.
  nextIndex      Int      @default(0)

  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  credentials    Credential[]

  @@unique([issuerDid, purpose])
  @@index([issuerDid])
}

enum CredentialCategory {
  BLOOD_WORK
  PRESCRIPTIONS
  VACCINATIONS
  IMAGING
  LAB_RESULTS
  INSURANCE
  GENERAL
  IDENTITY
  PROFESSIONAL
}

enum CredentialStatus {
  PENDING     // Offer received, not yet accepted
  ACTIVE      // Valid and usable
  EXPIRED     // Past expiration date
  REVOKED     // Revoked by issuer
  SUSPENDED   // Temporarily suspended
}

/// Credential schemas (for validation)
model CredentialSchema {
  id            String   @id @default(cuid())
  name          String
  version       String
  description   String?
  
  // Schema definition
  schema        Json     // JSON Schema
  
  // Attributes
  attributes    Json     // Array of attribute definitions
  
  // Source
  issuerDid     String?
  isPublic      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  credentials   Credential[]
  
  @@unique([name, version])
  @@index([name])
}

// ============================================================================
// VERIFIABLE PRESENTATIONS
// ============================================================================

/// Presentation requests and responses
model Presentation {
  id              String              @id @default(cuid())
  holderDid       String?
  verifierDid     String
  
  // Request details
  requestId       String              @unique // OID4VP request ID
  nonce           String
  
  // Presentation type
  presentationType PresentationType
  
  // Request parameters
  requestedCredentials Json           // What was requested
  selectedDisclosure   Json?          // What attributes were disclosed
  
  // Status
  status          PresentationStatus  @default(REQUESTED)

  /// The presented credentials and their DISCLOSED claims, captured at
  /// verification FROM THE VERIFIED VP ITSELF.
  ///
  /// WHY NOT READ FROM THE credentials RELATION. That relation links to a
  /// `Credential` row, and a credential the holder received directly from a
  /// hospital issuer has NO such row — it lives on the device. Measured 24 Sep
  /// 2026: a prescription verified, no PresentationCredential row was created,
  /// and the verifier was handed an empty object while the holder had disclosed
  /// a prescription. The VP carries the claims and its signature is what makes
  /// them trustworthy, so they are recorded here rather than looked up.
  presentedClaims Json?
  
  // Timestamps
  requestedAt     DateTime            @default(now())
  presentedAt     DateTime?
  verifiedAt      DateTime?
  expiresAt       DateTime
  
  // Verification result
  verificationResult Json?
  
  // Relations
  credentials     PresentationCredential[]
  consent         Consent?
  
  @@index([holderDid])
  @@index([verifierDid])
  @@index([status])
}

enum PresentationType {
  FULL            // Full credential disclosure
  SELECTIVE       // Selective attribute disclosure
  ZKP             // Zero-knowledge proof
}

enum PresentationStatus {
  REQUESTED       // Request created, awaiting holder response
  PENDING         // Holder notified, awaiting response
  ACCEPTED        // Holder accepted, presentation in progress
  PRESENTED       // Presentation submitted
  VERIFIED        // Successfully verified
  REJECTED        // Holder rejected
  EXPIRED         // Request expired
  FAILED          // Verification failed
}

/// Junction table for presentations containing multiple credentials
model PresentationCredential {
  id              String       @id @default(cuid())
  presentationId  String
  credentialId    String
  
  // Which attributes were disclosed from this credential
  disclosedAttributes String[]
  
  presentation    Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  credential      Credential   @relation(fields: [credentialId], references: [id])
  
  @@unique([presentationId, credentialId])
  @@index([presentationId])
  @@index([credentialId])
}

// ============================================================================
// CONSENT MANAGEMENT
// ============================================================================

/// Consent records for credential sharing
model Consent {
  id              String        @id @default(cuid())
  holderUserId    String?
  holderDid       String
  verifierDid     String
  verifierName    String
  
  // What was consented
  credentialTypes String[]      // Types of credentials
  credentialIds   String[]      // Specific credential IDs
  attributes      String[]      // Specific attributes
  
  // Consent scope
  purpose         ConsentPurpose
  purposeDetail   String?
  
  // Duration
  grantedAt       DateTime      @default(now())
  expiresAt       DateTime?
  
  // Status
  isActive        Boolean       @default(true)
  revokedAt       DateTime?
  revokedReason   String?
  
  // Access tracking
  accessCount     Int           @default(0)
  lastAccessedAt  DateTime?
  
  // Optional link to presentation
  presentationId  String?       @unique

  // THE HOLDER-SIGNED CONSENT RECEIPT (steno #279).
  //
  // The compact JWS the holder signed on their device at the moment of
  // disclosure. This row is an INDEX over that receipt, not the record itself:
  // the row is what the operator can query, the receipt is what the holder can
  // prove. If the two ever disagree, the receipt is right — it is the only one
  // of the pair that is signed.
  //
  // Nullable because pre-receipt rows may exist and because an emergency-access
  // record is created without a holder present. A row with no receipt is
  // exactly as trustworthy as this operator, and no more; `receiptVerifiedAt`
  // is what distinguishes the two cases at a glance.
  receiptJws        String?     @db.Text
  /// Kantara `consentReceiptID` (the receipt's `jti`). Unique, so replaying one
  /// receipt cannot create a second consent row.
  receiptId         String?     @unique
  receiptVerifiedAt DateTime?
  /// Whether this record grants access that CONTINUES, or documents an act that
  /// is already finished.
  ///
  /// A presentation is a completed disclosure: the verifier already holds the
  /// claims and nothing will re-fetch anything, so `false` here means "Revoke"
  /// would be theatre — it cannot un-send what was sent. Recording a one-time
  /// disclosure as a 24-hour standing permission was how this screen came to
  /// offer a control whose promise the system cannot keep.
  standingAccess    Boolean   @default(false)
  /// The verifier's OWN words. `purpose` is our five-value enum and is lossy by
  /// construction; this is what they actually asked for.
  purposeText       String?
  
  // Relations
  // NO `verifier` RELATION, DELIBERATELY.
  //
  // `verifierDid` used to be a foreign key into `User.did`, which required every
  // verifier to hold an account on THIS backend. That is the centralisation the
  // whole design removes: a verifier is any party holding a DID and presenting a
  // request, and a pharmacy has no reason to be our user. The constraint made
  // every consent write for an external verifier fail with a foreign key
  // violation, so no consent record had ever been written (observed 9 Sep 2026:
  // presentation VERIFIED, Consent table empty).
  //
  // The holder-signed receipt is what makes the row trustworthy now — see
  // `receiptJws`. Authenticity comes from the holder's signature, not from the
  // verifier being someone we already know.
  holder          User?         @relation("HolderConsents", fields: [holderUserId], references: [id])
  presentation    Presentation? @relation(fields: [presentationId], references: [id])
  accessLogs      ConsentAccessLog[]
  
  @@index([holderDid])
  @@index([verifierDid])
  @@index([isActive])
  @@index([purpose])
}

enum ConsentPurpose {
  TREATMENT       // Medical treatment @map("treatment")
  INSURANCE_CLAIM // Insurance claims @map("insurance_claim")
  RESEARCH        // Medical research @map("research")
  EMERGENCY       // Emergency access @map("emergency")
  REFERRAL        // Healthcare referrals @map("referral")
}

/// Log of each access under a consent
model ConsentAccessLog {
  id          String   @id @default(cuid())
  consentId   String
  
  // Access details
  accessedAt  DateTime @default(now())
  accessType  String   // "read" | "verify" | "present"
  attributes  String[] // Which attributes were accessed
  
  // Context
  ipAddress   String?
  userAgent   String?
  
  consent     Consent  @relation(fields: [consentId], references: [id], onDelete: Cascade)
  
  @@index([consentId])
  @@index([accessedAt])
}

// ============================================================================
// CREDENTIAL ISSUANCE (OID4VCI)
// ============================================================================

/// Credential offers pending acceptance
model CredentialOffer {
  id              String            @id @default(cuid())
  issuerDid       String
  holderDid       String?           // May be unknown initially
  holderEmail     String?           // Email for pre-authorized offers
  
  // Offer details
  credentialType  String
  category        CredentialCategory
  
  // OID4VCI parameters
  preAuthorizedCode String?         @unique
  pinRequired     Boolean           @default(false)
  pin             String?           // Hashed PIN
  pinAttempts     Int               @default(0)
  pinLockedUntil  DateTime?
  
  // Offer content
  offerData       Json              // Credential data to be issued
  
  // Status
  status          OfferStatus       @default(PENDING)
  
  // Timestamps
  createdAt       DateTime          @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?
  
  @@index([issuerDid])
  @@index([holderDid])
  @@index([holderEmail])
  @@index([preAuthorizedCode])
  @@index([status])
}

enum OfferStatus {
  PENDING         // Awaiting acceptance
  ACCEPTED        // Accepted, credential issued
  REJECTED        // Rejected by holder
  EXPIRED         // Offer expired
  REVOKED         // Revoked by issuer
}

// ============================================================================
// EMERGENCY ACCESS
// ============================================================================

/// Emergency contacts for break-glass scenarios
model EmergencyContact {
  id              String   @id @default(cuid())
  userId          String
  
  // Contact info
  contactUserId   String?  // If contact is a registered user
  contactName     String
  contactEmail    String?
  contactPhone    String?
  relationship    String   // "spouse", "parent", "doctor", etc.
  
  // Permissions
  accessLevel     EmergencyAccessLevel @default(LIMITED)
  allowedCredentials String[] // Empty = all, otherwise specific types
  
  // Activation
  activationMethod EmergencyActivationMethod @default(MANUAL)
  inactivityDays  Int?     // For time-based activation
  
  // Status
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contact         User?    @relation("EmergencyContactUser", fields: [contactUserId], references: [id])
  
  @@index([userId])
  @@index([contactUserId])
}

enum EmergencyAccessLevel {
  FULL            // Full access to all credentials
  LIMITED         // Only essential medical info
  MINIMAL         // Emergency contact info only
}

enum EmergencyActivationMethod {
  MANUAL          // User must manually activate
  INACTIVITY      // Activate after X days of inactivity
  VERIFICATION    // Requires third-party verification
}

/// Emergency access records (break-glass access tracking)
model EmergencyAccessRecord {
  id                String   @id @default(cuid())
  
  // Patient
  patientDid        String
  
  // Requester
  requesterDid      String
  requesterName     String
  requesterRole     String   // "physician", "nurse", "paramedic", etc.
  requesterInstitution String
  
  // Access details
  reason            String   // Emergency reason
  credentialsAccessed String[] // List of credential IDs accessed
  accessLevel       EmergencyAccessLevel @default(LIMITED)
  
  // Status
  status            EmergencyAccessStatus @default(GRANTED)
  
  // Timing
  grantedAt         DateTime @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  
  // Audit
  ipAddress         String?
  userAgent         String?
  
  @@index([patientDid])
  @@index([requesterDid])
  @@index([status])
