// ============================================================================
// R5 — INSTITUTIONAL CUSTODY: THE SIGNING AUDIT LOG AND THE CHAIN SILENT ALARM
// ============================================================================
//
// Why these tables exist at all (steno #291, #293). Institutional custody is
// 1-of-N verification methods, and S-4 measured that this makes each of the N
// individually equivalent to the whole institution: one officer key alone can
// evict every other officer (H1, height 86424) and can permanently deactivate
// the institutional DID (G2+T1, code 1207). Neither is reversible. The owner
// accepted 1-of-N on the explicit condition that DETECTION makes the race
// winnable, so these tables are not reporting furniture — they are the control
// that the custody model's safety argument rests on.
//
// TWO INDEPENDENT SOURCES, DELIBERATELY NOT MERGED. `SigningAuditEntry` is what
// WE INTENDED; `ObservedDidTx` is WHAT ACTUALLY HAPPENED ON CHAIN. An attacker
// holding an officer key never has to touch this backend — they broadcast
// straight to the chain — so a chain event with no audit entry is the loudest
// signal available. Reconciling the two into one table would destroy exactly
// that signal.

/// One immutable line of the signing log. See `services/custody/signingAuditLog.ts`.
///
/// APPEND-ONLY IS ENFORCED BY A DATABASE TRIGGER, not by convention: UPDATE and
/// DELETE on this table raise. `seq`/`prevHash`/`entryHash` form a hash chain so
/// that dropping the trigger and rewriting history is DETECTABLE. Read the
/// header of `signingAuditLog.ts` for what the chain does and does not prove.
model SigningAuditEntry {
  /// Position in the hash chain. Assigned under an advisory lock, never reused.
  seq              Int      @id
  /// sha256 over the canonical serialisation of this entry, `prevHash` included.
  entryHash        String   @unique
  /// `entryHash` of seq-1. The genesis entry carries GENESIS_PREV_HASH.
  prevHash         String

  kind             SigningAuditKind
  /// Ties an INTENT to the RESULT or REJECTION that followed it.
  correlationId    String
  /// The uuid we mint for `MsgCreate/UpdateDidDocPayload.versionId`. This is the
  /// join key to the chain: it is our value and it appears in the on-chain
  /// payload, so it survives a crash between broadcast and result.
  versionId        String?

  subjectDid       String
  operation        String
  /// WHICH VERIFICATION METHOD SIGNED. Under 1-of-N this is the whole of
  /// attribution — there is no second signature to corroborate it.
  signedByVerificationMethodId String?

  /// WHAT WAS AUTHORISED, in full: the document being signed plus the delta.
  /// Enough to reconstruct the authorisation, not merely to name the opcode.
  payload          Json
  /// sha256 of the canonical payload, so a truncated `payload` is detectable.
  payloadDigest    String

  actorSource      String
  actorUserId      String?
  sourceIp         String?
  userAgent        String?
  requestId        String?

  txHash           String?
  height           Int?
  failureReason    String?

  occurredAt       DateTime
  recordedAt       DateTime @default(now())

  @@index([subjectDid])
  @@index([correlationId])
  @@index([versionId])
  @@index([kind])
  @@index([recordedAt])
}

enum SigningAuditKind {
  /// Written BEFORE broadcast. Carries the payload. Its existence is the claim
  /// "this backend was about to authorise exactly this".
  SIGNING_INTENT
  /// Written after a committed, code-0 delivery. Carries txHash and height.
  SIGNING_RESULT
  /// Written when the broadcast was refused or failed. An intent with neither a
  /// RESULT nor a REJECTION is itself a finding.
  SIGNING_REJECTED
}

/// A did:cheqd whose `MsgUpdateDidDoc` / `MsgDeactivateDidDoc` traffic is watched.
///
/// `lastSeen*` is the watcher's running picture of the document, advanced strictly
/// in block order. It is what makes "an officer was EVICTED" distinguishable from
/// "an officer key was ROTATED" without a second chain query.
model WatchedInstitutionalDid {
  did                       String   @id
  label                     String
  /// Height at which watching began. Anything earlier was never observed and
  /// must not be reported as if it had been.
  watchedFromHeight         Int
  lastSeenVerificationMethodIds String[]
  lastSeenVerificationMethodDigest String
  lastSeenControllers       String[]
  lastSeenVersionId         String?
  lastSeenHeight            Int?
  deactivated               Boolean  @default(false)
  registeredAt              DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

/// The watcher's resume point. Exactly one row, `id = 'default'`.
///
/// `lastScannedHeight` advances ONLY in the same transaction that commits the
/// findings for that height, so a crash re-scans rather than skips. A watcher
/// that silently skips the blocks it was down for looks like it is working,
/// which is worse than not having one.
model ChainWatchCursor {
  id                String   @id
  lastScannedHeight Int
  chainId           String
  startedFromHeight Int
  updatedAt         DateTime @updatedAt
}

/// One observed on-chain DID-module message. WHAT ACTUALLY HAPPENED.
///
/// Deduplicated by (txHash, msgIndex) so that re-scanning a height after a crash
/// is idempotent.
model ObservedDidTx {
  id           String   @id @default(cuid())
  txHash       String
  msgIndex     Int
  height       Int
  blockTime    DateTime
  typeUrl      String
  subjectDid   String
  versionId    String?
  /// DeliverTx code read from the tx index, NOT from a sync broadcast. `null`
  /// means the node could not tell us — treated as "it happened", never as "it
  /// did not".
  deliveryCode Int?
  signerVerificationMethodIds String[]
  /// The decoded message, verbatim enough to reconstruct the change.
  decoded      Json
  observedAt   DateTime @default(now())

  @@unique([txHash, msgIndex])
  @@index([subjectDid])
  @@index([height])
  @@index([versionId])
}

/// A raised alarm. Persisted so that an operator sees it after a restart and so
/// that "nobody was watching the log at 03:00" is not a way to lose the signal.
model CustodyAlarm {
  id            String        @id @default(cuid())
  raisedAt      DateTime      @default(now())
  severity      AlarmSeverity
  kind          AlarmKind
  attribution   AlarmAttribution
  subjectDid    String?
  txHash        String?
  height        Int?
  signerVerificationMethodIds String[]
  /// The one-paragraph statement an operator reads first: what happened, what it
  /// cannot be undone by, and what to do in the next few minutes.
  headline      String
  detail        Json
  /// Matching audit entry, when there is one. Absence is the alarm.
  matchedAuditSeq Int?
  acknowledgedAt  DateTime?
  acknowledgedBy  String?

  @@index([severity, raisedAt])
  @@index([kind])
  @@index([subjectDid])
  @@index([acknowledgedAt])
}

enum AlarmSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlarmKind {
  /// Irreversible. `code 1207`, no on-chain remedy exists (S-4 T1).
  DID_DEACTIVATED
  /// A verification method was REMOVED. After enough of these the institution
  /// holds no key and cannot rotate anything (S-4 H1, steno #291).
  OFFICER_EVICTED
  /// The controller set changed. Not repairable (S-1 §5.4).
  CONTROLLER_CHANGED
  /// Same slot, new key material. The routine, expected operation.
  OFFICER_ROTATED
  OFFICER_ADDED
  /// An update that changed no verification method and no controller.
  UPDATE_WITHOUT_KEY_CHANGE
  /// A DID-module message against a watched DID that the chain REJECTED.
  REJECTED_ATTEMPT
  /// We hold a SIGNING_RESULT the chain never showed us.
  BROADCAST_NOT_ON_CHAIN
  /// An intent that produced neither a result nor a rejection.
  INTENT_UNRESOLVED
  /// Blocks the watcher was down for can no longer be read (node pruning).
  WATCH_GAP_UNRECOVERABLE
  /// The watcher has not advanced for longer than its stall threshold.
  WATCHER_STALLED
  /// The signing log's hash chain does not verify.
  AUDIT_CHAIN_TAMPERED
}

enum AlarmAttribution {
  /// A signing audit entry accounts for this chain event.
  MATCHED
  /// NO audit entry accounts for it. Someone acted without going through us —
  /// the loudest signal this system can produce. Never downgrade it.
  UNMATCHED
  /// Not a chain event (watcher health, log integrity).
  NOT_APPLICABLE
}

// ============================================================================
// R5 — IDENTITY RE-ISSUANCE ("visa re-issuance")
//
// The problem these three models solve is the one the passport analogy names:
// when a holder's DID is permanently unrecoverable, the holder needs a new
// identifier AND every authority that issued a credential against the old one
// has to issue it again against the new one. Nothing in this schema recorded
// either half. `Credential.holderDid` says what a credential is bound to; it
// says nothing about what SUPERSEDED what, so a re-issuance run could not be
// resumed, could not be made idempotent, and left no trail an auditor could
// follow from the old identity to the new one.
//
// WHY THE LINEAGE IS A TABLE AND NOT A COLUMN. A `supersededBy` column on
// Credential would record the edge but not the ACT: who authorised it, on what
// evidence, when it was authorised versus when it ran, and which of the
// credentials bound to the dead DID were deliberately NOT carried forward. The
// last of those is the one that matters in an audit — "this credential was not
// re-issued because the issuer had already revoked it" is a finding, and a null
// column cannot express it.
// ============================================================================

/// The authorisation to re-issue an identity, and the whole of its authentication.
///
/// THE HOLDER'S KEY CANNOT AUTHENTICATE THIS. The missing key is the entire
/// problem, so authority has to come from the institutional half of the 2-of-2
/// controller set (S-1 §8.3) — which is exactly the trust relationship that
/// enrolment establishes, and exactly what the thesis is arguing about.
///
/// `institutionalSignature` is an Ed25519 signature by ONE of the institutional
/// DID's N verification methods (any one suffices, S-4 M1) over
/// `authorisationDigest`. Anyone who can resolve the institutional DID can check
/// it without asking this backend anything, which is the property that makes it
/// evidence rather than a log line.
///
/// WHAT IT ASSUMES, WRITTEN DOWN RATHER THAN IMPLIED: that the institution's
/// out-of-band identity check was sound. A dishonest officer can migrate any
/// legacy patient onto a DID they control and no cryptographic control can stop
/// them, because the only key that could object is the one that is gone. So the
/// design does not pretend to prevent it — it makes it single-use, expiring,
/// attributable to a named officer and a named key, and hash-chained into
/// SigningAuditEntry, so the act is small, visible and countable (#302).
model ReissuanceAuthorisation {
  id                String   @id @default(cuid())

  /// The dead identity this authorises the replacement of. UNIQUE: a second
  /// authorisation for the same DID is a fork of an identity, not a retry.
  oldDid            String   @unique
  /// The account the officer identified in person. The off-chain anchor.
  userId            String

  /// Which institution vouched, and WHICH KEY of it signed. Under 1-of-N the
  /// signing verification method is the whole of attribution — there is no
  /// second signature to corroborate it (steno #291).
  institutionalDid  String
  institutionalVerificationMethodId String

  /// sha256 over the canonical BDHT-REISSUANCE-AUTHORISATION-v1 statement.
  authorisationDigest String @unique
  /// base64 Ed25519 signature over `authorisationDigest` by the method above.
  institutionalSignature String
  /// Single-use. The unique index is what makes replay unconstructable rather
  /// than merely discouraged.
  nonce             String   @unique

  /// WHO did the in-person check, and against WHAT. The evidence itself is
  /// never stored — a national ID number in this table would be a worse
  /// liability than the problem it documents. Only a reference and a digest.
  officerId         String
  officerName       String
  evidenceKind      ReissuanceEvidenceKind
  evidenceReference String
  evidenceDigest    String

  /// Short-lived on purpose. An authorisation that cannot expire is a standing
  /// permission to seize an identity.
  notBefore         DateTime
  notAfter          DateTime

  createdAt         DateTime @default(now())
  consumedAt        DateTime?

  succession        DidSuccession?

  @@index([userId])
  @@index([institutionalDid])
}

enum ReissuanceEvidenceKind {
  /// Bangladesh National ID card, checked in person.
  NATIONAL_ID_IN_PERSON
  BIRTH_CERTIFICATE_IN_PERSON
  PASSPORT_IN_PERSON
  /// The holder was identified by an already-enrolled guardian or next of kin.
  VOUCHED_BY_ENROLLED_GUARDIAN
  /// Reserved for a migration run by an operator against test data. Never
  /// acceptable for a real patient; kept distinct so it is greppable.
  OPERATOR_TEST_DATA
}

/// The old passport → new passport link. One row per migrated identity.
///
/// This is what makes an old DID discoverably DEAD without deactivating it.
/// Deactivation is deliberately NOT the mechanism: `MsgDeactivateDidDoc` needs
/// signatures from controllers ∪ ALL verification-method controllers (S-1 D1),
/// which for the unrecoverable shape is the lost key itself — so in the general
/// case the old DID CANNOT be deactivated, and a procedure that requires the key
/// it has just declared lost is not a procedure. S-4 T1 adds that deactivation
/// is terminal and is itself a transaction that can fail.
model DidSuccession {
  id            String @id @default(cuid())

  /// UNIQUE both ways. One old DID has exactly one successor, and no DID is the
  /// successor of two identities — either would be an identity fork, and a
  /// unique index makes it unconstructable instead of merely unlikely.
  oldDid        String @unique
  newDid        String @unique
  userId        String

  reason        DidSuccessionReason
  status        DidSuccessionStatus @default(PLANNED)
  disposition   OldDidDisposition   @default(MARKED)

  authorisationId String @unique
  authorisation   ReissuanceAuthorisation @relation(fields: [authorisationId], references: [id])

  /// Chain coordinates of the NEW identity, read back from the ledger rather
  /// than taken from the broadcast result.
  newDidTxHash  String?
  newDidHeight  Int?
  /// Set only when `disposition = DEACTIVATED`, which is available only while
  /// the old key survives — i.e. never in the failure mode this exists for.
  deactivationTxHash String?
  deactivationHeight Int?

  /// The worklist counters, so "was this migration complete?" is answerable
  /// without recounting the child rows.
  credentialsFound     Int @default(0)
  credentialsReissued  Int @default(0)
  credentialsSkipped   Int @default(0)
  credentialsFailed    Int @default(0)

  startedAt     DateTime @default(now())
  completedAt   DateTime?
  /// Populated when the run stopped without completing. An abandoned migration
  /// must be legible as abandoned, not as finished.
  abandonedAt   DateTime?
  abandonReason String?

  credentials   CredentialReissuance[]

  @@index([userId])
  @@index([status])
}

enum DidSuccessionReason {
  /// S-1 R0 / S-4 NC2: single self-controlled verification method. The device
  /// key cannot be replaced because replacing it requires itself.
  UNRECOVERABLE_SHAPE_LEGACY
  /// Correct shape, but the recovery controller was lost too, so rotation is
  /// unavailable and only re-issuance remains.
  RECOVERY_CONTROLLER_LOST
  /// The device key is believed to be in an attacker's hands and the identity
  /// is being abandoned rather than rotated.
  DEVICE_KEY_COMPROMISED
}

enum DidSuccessionStatus {
  /// Authorised and recorded; the new DID does not exist yet.
  PLANNED
  /// The new DID is on chain and the credential worklist is being drained.
  MIGRATING
  /// Every credential reached a terminal outcome and the old DID is tombstoned.
  COMPLETE
  /// Stopped without completing. The old DID is still the live identity.
  ABANDONED
}

enum OldDidDisposition {
  /// Left resolvable on chain, marked dead HERE and by the revocation of every
  /// credential bound to it. The only disposition available when the key is
  /// genuinely lost, and therefore the only one the procedure depends on.
  MARKED
  /// Additionally deactivated on chain (`MsgDeactivateDidDoc`). Available ONLY
  /// while the old key survives, and refused when the DID owns DID-linked
  /// resources anything still needs to dereference.
  DEACTIVATED
}

/// One row per credential that was bound to the dead DID — INCLUDING the ones
/// deliberately not carried forward.
///
/// `oldCredentialId` is unique, and that single constraint is what makes the
/// whole migration idempotent: a re-run cannot issue a second replacement for a
/// credential that already has one, and a crash mid-run resumes instead of
/// restarting. The row is written in PENDING BEFORE any signing happens, so the
/// worklist is durable and a partial run is countable rather than invisible.
model CredentialReissuance {
  id              String @id @default(cuid())

  successionId    String
  succession      DidSuccession @relation(fields: [successionId], references: [id], onDelete: Cascade)

  /// THE IDEMPOTENCY KEY.
  oldCredentialId String @unique
  newCredentialId String? @unique

  outcome         ReissuanceOutcome @default(PENDING)
  /// Why a non-REISSUED outcome was reached. Required reading in an audit: the
  /// interesting rows are the ones that were NOT carried forward.
  detail          String?

  /// Copied from the old row so the decision is auditable even if the old row
  /// is later purged.
  oldCredentialHash String
  oldStatus         String
  oldFormat         String?

  attemptedAt     DateTime @default(now())
  settledAt       DateTime?

  @@index([successionId])
  @@index([outcome])
}

enum ReissuanceOutcome {
  /// Written before signing. An entry still PENDING after a run is residue and
  /// must stay countable.
  PENDING
  /// A replacement credential exists, bound to the new DID, and the old one has
  /// been revoked.
  REISSUED
  /// The issuer had already revoked it. Carrying it forward would re-issue a
  /// statement the issuer withdrew.
  SKIPPED_REVOKED
  /// Already past `expiresAt`. Re-issuing would silently extend a validity the
  /// issuer never granted.
  SKIPPED_EXPIRED
  /// The issuer holds no revocation coordinates for it (`statusListIndex` is
  /// null), so it can be neither revoked nor safely superseded. THE MEASURED
  /// TRACKING GAP — see the module header in services/reissuance/.
  UNTRACKABLE
  /// Signing or persistence failed. The old credential is untouched.
  FAILED
}

// ============================================================================
// R5 PHASE C — GUARDIAN-SHARE BACKUP VAULT
// ============================================================================

/// Tracks the durability copy of the INSTITUTION guardian's SLIP-39 share in
/// the backup vault (packages/backup-vault). A FAILED deposit must NOT fail
/// enrolment — the guardian share physically exists with the guardian
/// regardless of whether this copy landed — but "the ceremony completes and
/// the copy silently doesn't exist" is a fail-open with a delay fuse that only
/// surfaces during a recovery attempt. This row is the compensating control:
/// the answer to "how many patients are missing their institutional share
/// copy?" is `SELECT COUNT(*) WHERE status = 'PENDING'`, not an unknown
/// (owner amendment 2, R5 Phase C).
///
/// One row per recovery-controller DID. Re-attempts UPDATE the same row
/// (attempts, lastError, lastAttemptAt) rather than accumulating duplicates —
/// the unique constraint on `recoveryControllerDid` is what makes the count
/// meaningful.
model InstitutionShareBackupJob {
  id                     String                @id @default(cuid())
  recoveryControllerDid  String                @unique
  status                 BackupJobStatus       @default(PENDING)
  attempts               Int                   @default(1)
  lastError              String?
  lastAttemptAt          DateTime              @default(now())
  succeededAt            DateTime?
  createdAt              DateTime              @default(now())

  @@index([status])
}

enum BackupJobStatus {
  /// Not yet confirmed deposited. Covers both "about to try" and "tried and
  /// failed, awaiting retry" — both answer the same operational question.
  PENDING
  /// The vault confirmed the deposit (2xx from PUT .../shares/:index).
  SUCCEEDED
}

// ============================================================================
// R6 — L1 IDENTITY AND LICENCE ISSUANCE
//
// The gap this closes (IDENTITY-VERIFICATION-API.md): the wallet has shown a
// "Verified" badge with no route behind it. A submission here is a holder
// asking an L1 authority (ministry or a professional council) to review
// documents held ENCRYPTED IN THE LOCKER — never here — and, on approval,
// issue a credential through the existing CredentialOffer/OID4VCI path
// (`services: issuance.ts` builds the claims; the offer itself is the same
// row `POST /oid4vci/offers` creates).
//
// WHY `wrappedContentKey` IS ONE JSON COLUMN, NOT A SEPARATE TABLE OR ROW PER
// DOCUMENT. IDENTITY-AND-ISSUANCE-SPEC.md §3.4 is explicit: "one submission,
// one key" — every document in a submission is covered by a single officer
// hand-off, not one per file. This server validates the envelope's SHAPE
// (`services/issuance.ts`'s `wrappedContentKeyShape`) and never opens it —
// the same boundary `KeystoreEnvelope.envelope` draws around the passphrase
// envelope.
// ============================================================================

enum IssuanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// The holder withdrew it. Only reachable from PENDING.
  WITHDRAWN
}

/// A holder's request that an L1 authority review documents and issue a
/// credential. See the section header above for what this does and does not
/// carry.
model IssuanceRequest {
  id                String   @id @default(cuid())

  /// Optional so account deletion can `SET NULL` here exactly as it already
  /// does for `Credential.holderUserId` (see that column's migration) rather
  /// than being blocked by a decided submission's audit trail.
  holderUserId      String?
  /// Permanent snapshot. Unlike `holderUserId` this is never nulled — it is
  /// the DID the authority actually reviewed and, on approval, issued to.
  holderDid         String

  /// Key into `DOCUMENT_TYPES` in `@ssi-healthcare/shared`. Not a foreign key:
  /// the registry is a compiled-in literal, not a table (same reasoning as
  /// `PROFESSIONAL_TRUST_ROOTS` — see accreditation/index.ts).
  documentTypeId    String
  /// Snapshot of `DOCUMENT_TYPES[...].credentialType` at submission time.
  credentialType    String

  authorityInstitutionId String
  authority         Institution @relation(fields: [authorityInstitutionId], references: [id])
  /// Snapshot of the authority's DID at submission time, so a later DID
  /// rotation on the Institution row cannot retroactively change which key
  /// this submission's content key was wrapped to.
  authorityDid      String

  status            IssuanceRequestStatus @default(PENDING)

  /// The single-use wrapped content key for the WHOLE submission. Validated
  /// shape only (`services/issuance.ts`); this column is never decrypted by
  /// this server, and the value is NOT erased on release — release is
  /// tracked by `keyReleasedAt`, below, because the single-use property is
  /// about how many times the API hands it out, not about destroying it at
  /// rest.
  wrappedContentKey Json

  /// The holder's locker read capability (OFFICER-DOCUMENT-ACCESS.md §3, §6a),
  /// travelling on the same row as the wrapped key it grants access to —
  /// round 5's fix for "nothing carries the capability" (steno #389). Stored
  /// and returned OPAQUELY: this server validates its claims are internally
  /// consistent with the submission (services/issuance.ts,
  /// assertCapabilityMatchesSubmission) but cannot verify the SIGNATURE — the
  /// capability's `aud` is the authority's DID, never this backend's, so a
  /// signature check here would check the wrong audience. Unlike
  /// `wrappedContentKey` this is NOT single-use (OFFICER-DOCUMENT-ACCESS.md
  /// §4: the capability is time-bounded so an officer may re-open a document
  /// during one review) and so is returned on every read, not gated by
  /// `keyReleasedAt`.
  lockerCapability  Json

  /// Set by the FIRST `GET /api/authority/requests/:id`, and only the first —
  /// see the route for the compare-and-swap that makes this true even under
  /// concurrent requests or a crash mid-response.
  keyReleasedAt         DateTime?
  /// Plain reference, no FK — same pattern as `ReissuanceAuthorisation.officerId`.
  /// A membership can be deactivated without losing the record of who read the key.
  keyReleasedToMemberId String?

  decidedAt         DateTime?
  decidedByMemberId String?
  rejectionReason   String?
  /// Set on approval. The credential itself is issued later, when the holder
  /// redeems this offer — this row does not duplicate that state.
  issuedCredentialOfferId String?

  withdrawnAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  holder            User?    @relation(fields: [holderUserId], references: [id])
  documents         IssuanceRequestDocument[]

  @@index([holderUserId])
  @@index([holderDid])
  @@index([authorityInstitutionId])
  @@index([status])
}

/// One attached document: a reference into the locker, never the bytes
/// themselves. `contentHash` is the sha256 hex the locker itself already
/// checks against `X-Locker-Object-Hash` on write (packages/locker/src/server.ts)
/// — carried here so a later officer can confirm they are looking at the
/// object the holder actually declared, without this server ever fetching it.
model IssuanceRequestDocument {
  id                String @id @default(cuid())
  issuanceRequestId String
  lockerObjectId    String
  contentHash       String
  mediaType         String

  createdAt         DateTime @default(now())

  issuanceRequest   IssuanceRequest @relation(fields: [issuanceRequestId], references: [id], onDelete: Cascade)

  @@index([issuanceRequestId])
}
